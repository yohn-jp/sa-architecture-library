---
interface Props { title: string; description?: string; }
const { title, description = 'システムアーキテクト試験と設計実務をつなぐ技術叢書' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{title} | System Architect Library</title><link rel="stylesheet" href={base + 'styles.css'}/></head>
<body><header class="site-header"><a class="brand" href={base}>SYSTEM ARCHITECT <span>LIBRARY</span></a><nav aria-label="メインナビゲーション"><a href={base + 'complete/'}>Complete</a><a href={base + 'books/'}>Books</a><a href={base + 'syllabus/'}>Syllabus</a><a href={base + 'search/'}>Search</a></nav></header><main><slot /></main><footer><p>Independent educational commentary. IPA materials remain the property of their respective rights holders.</p><p><a href="https://github.com/yohn-jp/sa-architecture-library">GitHub repository</a></p></footer></body></html>
