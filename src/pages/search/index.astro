---
import SiteLayout from '../../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="全文検索"><section class="page-intro"><p class="eyebrow">SEARCH</p><h1>サイト内検索</h1><div id="search" data-pagefind-root={base + 'pagefind/'}></div></section><script>import { PagefindUI } from '@pagefind/default-ui'; import '@pagefind/default-ui/css/ui.css'; new PagefindUI({ element: '#search', bundlePath: document.querySelector('#search')?.getAttribute('data-pagefind-root') || '/pagefind/' });</script></SiteLayout>
