---
import SiteLayout from '../../../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<SiteLayout title="午後Ⅰ 演習答案" description="午後ⅠCBT型演習で保存した記述答案を採点せずに振り返ります。">
  <link slot="head" rel="stylesheet" href={base + 'practice-ui.css'} />
  <link slot="head" rel="stylesheet" href={base + 'pm1-ui.css'} />
  <div class="practice-shell pm1-result">
    <nav class="practice-breadcrumb" aria-label="現在の位置">
      <a href={base + 'practice/'}>演習</a><span aria-hidden="true">/</span>
      <a id="setup-link" href={base + 'practice/pm1/'}>午後Ⅰ</a><span aria-hidden="true">/</span>
      <span aria-current="page">答案確認</span>
    </nav>
    <header class="practice-intro">
      <p class="eyebrow">AFTERNOON I / WRITTEN RESPONSES</p>
      <h1>演習答案の確認</h1>
      <p>入力した解答とIPA公式解答例を設問ごとに並べて表示します。<strong>採点・得点予測は行いません。</strong></p>
    </header>
    <section class="practice-card pm1-result-overview" aria-label="演習結果の概要">
      <h2 id="year-heading">午後Ⅰ</h2>
      <dl>
        <div><dt>選択問題</dt><dd id="chosen-questions">—</dd></div>
        <div><dt>記述済み解答欄</dt><dd id="answer-count">—</dd></div>
        <div><dt>経過時間</dt><dd id="elapsed">—</dd></div>
      </dl>
      <p class="practice-note">公式解答例はIPA原本のテキストを設問ごとに表示します。自動採点・得点予測は行いません。</p>
    </section>
    <section id="result-questions" class="pm1-result-questions" aria-label="保存した記述解答"></section>
    <div class="pm1-result-actions">
      <button id="copy-ai-prompt" type="button" class="practice-button" disabled>AI採点・解説用プロンプトをコピー</button>
      <span id="copy-ai-status" role="status" aria-live="polite"></span>
      <a id="source-pdf" class="practice-button secondary" href={base + 'practice/pm1/'} target="_blank" rel="noopener noreferrer">公式問題冊子を開く</a>
      <a id="source-page" href="https://www.ipa.go.jp/shiken/mondai-kaiotu/" target="_blank" rel="noopener noreferrer">IPA配布ページ</a>
      <a id="back" href={base + 'practice/pm1/'}>年度を選択・新しい演習を開始 →</a>
    </div>
    <p id="result-error" class="practice-error" role="alert" hidden></p>
  </div>
  <noscript><p>保存した答案の確認にはJavaScriptが必要です。</p></noscript>
</SiteLayout>

<script>
  import { findPm1Year } from '../../../data/pm1';
  import {
    loadPm1Session, pm1Expired, finishPm1Session, countPm1Answers, formatPm1Clock
  } from '../../../lib/pm1-session';
  import type { Pm1Session } from '../../../lib/pm1-session';
  import officialAnswers from '../../../data/pm1-official-answers.json';
  import pm1Fields from '../../../data/pm1-fields.json';
  const $ = (id: string) => document.getElementById(id)!;
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const year = findPm1Year(new URLSearchParams(location.search).get('year'));
  let session = year ? loadPm1Session(year.id) : null;
  const setupUrl = base + 'practice/pm1/' + (year ? '?year=' + encodeURIComponent(year.id) : '');
  const examUrl = base + 'practice/pm1/exam/?year=' + encodeURIComponent(year?.id ?? '');

  function render(complete: Pm1Session): void {
    if (!year) return;
    $('year-heading').textContent = year.label;
    $('chosen-questions').textContent = complete.selected.map(n => '問' + n).join('・');
    $('answer-count').textContent = countPm1Answers(complete) + '欄';
    const seconds = Math.floor(Math.min(
      complete.finishedAt! - complete.startedAt, (complete.durationMinutes ?? 90) * 60 * 1000
    ) / 1000);
    $('elapsed').textContent = formatPm1Clock(seconds);
    ($('source-pdf') as HTMLAnchorElement).href = base + 'practice/pm1/pdfs/' + year.id + '.pdf';
    ($('source-page') as HTMLAnchorElement).href = year.sourcePage;
    ($('back') as HTMLAnchorElement).href = setupUrl;
    ($('setup-link') as HTMLAnchorElement).href = setupUrl;

    const root = $('result-questions');
    root.replaceChildren();
    for (const number of complete.selected) {
      const section = document.createElement('section');
      section.className = 'pm1-result-section';
      const heading = document.createElement('h2');
      heading.textContent = '問' + number;
      section.append(heading);
      type Example = {
        id: string;
        label: string;
        text: string;
        source: { answerPage: number; table: number; row: number };
      };
      type Archive = Record<string, {
        sourcePdf: string;
        sha256: string;
        questions: Record<string, Example[]>;
      }>;
      const archives = officialAnswers as Archive;
      const source = archives[year.id];
      const officialRows = source?.questions[String(number)] ?? [];
      const ownRows = complete.answers[String(number)] ?? [];
      const byId = new Map(ownRows.map(row => [row.id, row]));
      const officialIds = new Set(officialRows.map(item => item.id));

      function renderAnswer(
        labelText: string, ownText: string, limit: number | null, answerText: string | null, pdfPage: number | null
      ): HTMLElement {
        const card = document.createElement('article');
        card.className = 'pm1-result-answer';
        const heading = document.createElement('div');
        heading.className = 'pm1-result-answer-top';
        const label = document.createElement('strong');
        label.textContent = labelText;
        const count = document.createElement('span');
        count.textContent = String(Array.from(ownText).length) + (limit === null ? '字' : ' / ' + limit + '字');
        if (limit !== null && Array.from(ownText).length > limit) count.className = 'is-over';
        heading.append(label, count);

        const comparison = document.createElement('div');
        comparison.className = 'pm1-answer-comparison';
        const mine = document.createElement('div');
        mine.className = 'pm1-comparison-cell';
        const mineTitle = document.createElement('h3');
        mineTitle.textContent = '自分の解答';
        const mineText = document.createElement('p');
        mineText.className = 'pm1-result-text';
        mineText.textContent = ownText.trim() || '（未記入）';
        mine.append(mineTitle, mineText);

        const official = document.createElement('div');
        official.className = 'pm1-comparison-cell pm1-official-response';
        const officialTitle = document.createElement('h3');
        officialTitle.textContent = 'IPA公式解答例';
        const officialText = document.createElement('p');
        officialText.className = 'pm1-result-text';
        officialText.textContent = answerText ?? '（追加したメモ欄のため公式解答例はありません）';
        official.append(officialTitle, officialText);
        if (pdfPage !== null && source) {
          const citation = document.createElement('a');
          citation.className = 'pm1-answer-citation';
          citation.href = source.sourcePdf + '#page=' + pdfPage;
          citation.target = '_blank';
          citation.rel = 'noopener noreferrer';
          citation.textContent = 'IPA解答例原本 ' + pdfPage + 'ページ';
          official.append(citation);
        }
        comparison.append(mine, official);
        card.append(heading, comparison);
        return card;
      }

      for (const official of officialRows) {
        const own = byId.get(official.id);
        const prescribed = (awaitedField: unknown): number | null => {
          if (!awaitedField || typeof awaitedField !== 'object') return null;
          const value = awaitedField as { limit?: unknown };
          return typeof value.limit === 'number' ? value.limit : null;
        };
        const canonical = (pm1Fields as Record<string, Record<string,
          Array<{ id: string; limit: number | null }>>>)[year.id]?.[String(number)]
          ?.find(row => row.id === official.id);
        section.append(renderAnswer(
          official.label, own?.text ?? '', prescribed(canonical),
          official.text, official.source.answerPage
        ));
      }

      // Preserve answers from sessions created before structured fields were added.
      // Never conflate a manual/legacy answer with an official answer by position.
      for (const own of ownRows) {
        if (officialIds.has(own.id)) continue;
        section.append(renderAnswer(own.label, own.text, own.limit, null, null));
      }
      root.append(section);
    }
  }

  function buildAiPrompt(complete: Pm1Session): string {
    if (!year) return '';
    type Example = { id: string; label: string; text: string };
    type Archive = Record<string, { sourcePdf: string; questions: Record<string, Example[]> }>;
    const archive = (officialAnswers as Archive)[year.id];
    const fields = (pm1Fields as Record<string, Record<string, Array<{ id: string; limit: number | null }>>>)[year.id];
    const repo = 'https://github.com/yohn-jp/sa-architecture-library';
    const lines = [
      'あなたはシステムアーキテクト試験・午後Ⅰの採点者です。',
      '設問要求と問題文の文脈を踏まえ、受験者解答をIPA公式解答例と比較して採点・解説してください。',
      '表現の一致だけで判定せず、意味の一致と重要要素を評価し、部分点を認めてください。',
      '公式配点が不明な場合は推定採点と明示してください。根拠のない断定は避けてください。',
      '各設問の評価、採点根拠、過不足、字数制限内の改善解答、総合評価と復習論点を示してください。',
      '参照資料を取得できない場合はその旨を明示し、未確認の問題文や図表を推測で補わないでください。',
      '',
      '【試験】' + year.label + ' システムアーキテクト試験 午後Ⅰ',
      '【演習結果】' + location.href,
      '【問題冊子】' + new URL(base + 'practice/pm1/pdfs/' + year.id + '.pdf', location.origin).href,
      '【問題・解答データのリポジトリ】' + repo,
      '【公式解答例原本】' + (archive?.sourcePdf ?? year.sourcePage),
      ''
    ];
    for (const number of complete.selected) {
      lines.push('## 問' + number);
      const ownRows = complete.answers[String(number)] ?? [];
      const byId = new Map(ownRows.map(row => [row.id, row]));
      const officialRows = archive?.questions[String(number)] ?? [];
      for (const item of officialRows) {
        const limit = fields?.[String(number)]?.find(row => row.id === item.id)?.limit;
        lines.push('【' + item.label + '】',
          '字数制限：' + (typeof limit === 'number' ? limit + '字' : '指定なし'),
          '受験者解答：' + (byId.get(item.id)?.text.trim() || '（未記入）'),
          'IPA公式解答例：' + item.text, '');
      }
      const officialIds = new Set(officialRows.map(item => item.id));
      for (const item of ownRows) {
        if (officialIds.has(item.id)) continue;
        lines.push('【' + item.label + '（追加・旧形式の解答欄）】',
          '字数制限：' + (item.limit === null ? '指定なし' : item.limit + '字'),
          '受験者解答：' + (item.text.trim() || '（未記入）'),
          'IPA公式解答例：なし', '');
      }
    }
    return lines.join('\n');
  }

  const copyButton = $('copy-ai-prompt') as HTMLButtonElement;
  copyButton.disabled = !session?.finishedAt;
  copyButton.addEventListener('click', async () => {
    if (!session?.finishedAt) return;
    try {
      await navigator.clipboard.writeText(buildAiPrompt(session));
      $('copy-ai-status').textContent = 'プロンプトをコピーしました。';
    } catch {
      $('copy-ai-status').textContent = 'コピーできませんでした。ブラウザのクリップボード権限を確認してください。';
    }
  });

  if (!year || !session) {
    location.replace(setupUrl);
  } else if (session.finishedAt === null && !pm1Expired(session)) {
    location.replace(examUrl);
  } else {
    if (session.finishedAt === null) {
      const updated = finishPm1Session(session);
      if (updated) session = updated;
      else {
        $('result-error').textContent = '演習終了状態を保存できませんでした。ブラウザの保存先を確認してください。';
        $('result-error').hidden = false;
      }
    }
    if (session.finishedAt !== null) render(session);
  }
</script>
