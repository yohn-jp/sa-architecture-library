---
import SiteLayout from '../../layouts/SiteLayout.astro';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const years = [
  {label:'2025年度（令和7年・春期）',id:'2025r07h',list:'2025r07',key:'エエイウアアウイアエエエエイアウウエエウエウウエイ'},
  {label:'2024年度（令和6年・春期）',id:'2024r06h',list:'2024r06',key:'エイウエイアアアエアウイウイウエウアウエアアウエイ'},
  {label:'2023年度（令和5年・春期）',id:'2023r05h',list:'2023r05',key:'イイウアアイイアアエアアウウエウアエエイウウエエイ'},
  {label:'2022年度（令和4年・春期）',id:'2022r04h',list:'2022r04',key:'イイエイイイイエウアエイエウイエアイウエイエエイア'},
  {label:'2021年度（令和3年・春期）',id:'2021r03h',list:'2021r03',key:'イイウウウイアアイウイイアエウアアウイエイイウアイ'},
  {label:'2019年度（令和元年・秋期）',id:'2019r01a',list:'2019h31',key:'イウイアウアイアエエウイイアウエエエエアウアウアウ'},
  {label:'2018年度（平成30年・秋期）',id:'2018h30a',list:'2018h30',key:'イエエエアアアウウアエイイエウイウウイエイエアウイ'},
  {label:'2017年度（平成29年・秋期）',id:'2017h29a',list:'2017h29',key:'エウアウイアウイアウウアイイウエエイウエアアウアエ'},
  {label:'2016年度（平成28年・秋期）',id:'2016h28a',list:'2016h28',key:'ウエエウイイアエウイイウエイウエエエエアエエイアア'}
];
---
<SiteLayout title="午前Ⅱ 全年度ランダム演習">
<section class="random"><p class="eyebrow">RANDOM PRACTICE · 225 QUESTIONS</p><h1>全年度ランダム演習</h1><p>9回分225問から重複なくランダム出題。各問を回答後すぐに採点します。</p><p><a href={base+'practice/'}>← 年度別演習に戻る</a></p>
<div class="toolbar"><span id="progress">1 / 225</span><span id="stats">正解 0 / 解答 0</span><button id="restart" type="button">最初からやり直す</button></div>
<div class="question"><h2 id="heading">問題</h2><a id="large" target="_blank" rel="noopener noreferrer"><img id="question" alt="問題文と選択肢" width="1210" /></a><p id="load-error" hidden role="alert">画像の読み込みに失敗しました。</p><fieldset id="choices"><legend>解答を選択</legend><label><input type="radio" name="choice" value="ア"> ア</label><label><input type="radio" name="choice" value="イ"> イ</label><label><input type="radio" name="choice" value="ウ"> ウ</label><label><input type="radio" name="choice" value="エ"> エ</label></fieldset><button id="check" type="button">この問題を採点</button><p id="feedback" role="status" aria-live="polite"></p><section id="explanation" hidden><h3>解説</h3><p id="explanation-text"></p><p><a id="official" target="_blank" rel="noopener noreferrer">IPA公式問題・解答例</a></p></section><button id="next" type="button" hidden>次の問題 →</button></div></section>
</SiteLayout>
<script define:vars={{years,base}}>
const $=id=>document.getElementById(id);
const all=years.flatMap(y=>Array.from({length:25},(_,i)=>({id:y.id,label:y.label,list:y.list,number:i+1,correct:y.key[i]})));
const storeKey='sa-am2-random-v1';
const state={order:[],index:0,results:{}};
const randomOrder=()=>{const a=Array.from({length:225},(_,i)=>i);for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
function persist(){try{localStorage.setItem(storeKey,JSON.stringify(state))}catch{}}
function initialize(reset=false){let saved=null;if(!reset){try{saved=JSON.parse(localStorage.getItem(storeKey)||'null')}catch{}}
if(saved&&Array.isArray(saved.order)&&saved.order.length===225&&new Set(saved.order).size===225&&saved.order.every(n=>Number.isInteger(n)&&n>=0&&n<225)&&Number.isInteger(saved.index)&&saved.index>=0&&saved.index<=225&&saved.results&&typeof saved.results==='object'){
state.order=saved.order;state.index=saved.index;state.results=saved.results;
}else{state.order=randomOrder();state.index=0;state.results={};persist()}render()}
const current=()=>all[state.order[state.index]];
function render(){const answered=Object.keys(state.results).length;const correct=Object.entries(state.results).filter(([i,v])=>all[Number(i)]?.correct===v).length;
$('stats').textContent='正解 '+correct+' / 解答 '+answered;
$('progress').textContent=Math.min(state.index+1,225)+' / 225';
if(state.index===225){$('heading').textContent='全225問を完了しました';$('question').hidden=true;$('choices').hidden=true;$('check').hidden=true;$('next').hidden=true;$('explanation').hidden=true;$('feedback').textContent='正解 '+correct+' / 225 問';return}
const q=current(),n=state.order[state.index],result=state.results[n];
$('heading').textContent=q.label+' · 問'+q.number;
const url=base+'practice/questions/'+q.id+'/q'+String(q.number).padStart(2,'0')+'.webp';$('question').hidden=false;$('question').src=url;$('question').alt=q.label+' 問'+q.number+'の問題文と選択肢';$('large').href=url;$('load-error').hidden=true;
$('choices').hidden=false;for(const radio of document.querySelectorAll('input[name=choice]')){radio.checked=radio.value===result;radio.disabled=Boolean(result)}
$('check').hidden=Boolean(result);$('next').hidden=!result;
$('next').textContent=state.index===224?'結果を見る':'次の問題 →';
$('feedback').textContent=result?((result===q.correct?'正解':'不正解')+' · あなたの解答：'+result+' ／ 正解：'+q.correct):'';
$('explanation').hidden=!result;
$('explanation-text').textContent='この問題の個別解説は現在準備中です。正答は公式解答例に基づいています。';
$('official').href='https://www.ipa.go.jp/shiken/mondai-kaiotu/'+q.list+'.html';
}
$('check').addEventListener('click',()=>{const choice=document.querySelector('input[name=choice]:checked');if(!choice){$('feedback').textContent='解答を選択してください。';return}const n=state.order[state.index];if(state.results[n])return;state.results[n]=choice.value;persist();render()});
$('next').addEventListener('click',()=>{if(!state.results[state.order[state.index]])return;state.index++;persist();render();window.scrollTo({top:0,behavior:'smooth'})});
$('restart').addEventListener('click',()=>{if(confirm('ランダム演習の進捗を消去して最初からやり直しますか？'))initialize(true)});
$('question').addEventListener('error',()=>{$('load-error').hidden=false});
initialize();
</script>
<style>
.random{max-width:900px;margin:0 auto;padding:55px 0}.random h1{font-size:clamp(27px,4vw,40px)}.toolbar{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin:22px 0}.toolbar span{font-weight:700}.toolbar button{margin-left:auto}.question{background:#fff;border:1px solid var(--line);border-radius:10px;padding:24px}.question h2{font-size:21px}.question img{width:100%;height:auto;display:block}.question>a{display:block;overflow-x:auto}fieldset{border:0;padding:20px 0;display:grid;grid-template-columns:repeat(4,1fr);gap:10px}legend{font-weight:700}fieldset label{display:flex;gap:8px;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:8px;padding:12px;font-size:20px;cursor:pointer}button{font:inherit;background:var(--accent);color:white;border:0;border-radius:7px;padding:10px 18px;cursor:pointer}#feedback{font-weight:700}#explanation{padding:15px 20px;background:#f5f7f5;border-radius:8px;margin:16px 0}@media(max-width:650px){.random{padding:30px 0}.question{padding:12px}.question>a img{min-width:690px}.toolbar button{margin-left:0}}
</style>