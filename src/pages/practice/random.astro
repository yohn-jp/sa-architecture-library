---
import SiteLayout from '../../layouts/SiteLayout.astro';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<SiteLayout title="午前Ⅱ 全年度ランダム演習">
<section class="random"><p class="eyebrow">RANDOM PRACTICE · 225 QUESTIONS</p><h1>全年度ランダム演習</h1><p>9回分225問から重複なくランダム出題。各問を回答後すぐに採点します。</p><p><a href={base+'practice/'}>← 演習モードを選ぶ</a>　 /　 <a href={base+'practice/year/'}>年度別模擬試験へ</a>　 /　 <a href={base+'practice/review/'}>間違えた問題を復習</a></p>
<div class="toolbar"><span id="progress">1 / 225</span><span id="stats">正解 0 / 解答 0</span><div class="toolbar-actions"><a id="review-link" href={base+"practice/review/"} class="review-link">復習ノート <span id="mistake-count">0</span>問</a><label class="fast-toggle" for="fast-mode"><input id="fast-mode" type="checkbox" role="switch" aria-describedby="fast-hint" /><span class="toggle-track" aria-hidden="true"></span><span>高速演習</span></label><button id="restart" type="button">最初からやり直す</button></div></div><p id="fast-hint" class="fast-hint" hidden>高速演習：選択すると即時採点し、約0.8秒後に次の問題へ進みます。解説は表示しません。</p>
<div class="question" id="question-card"><h2 id="heading" tabindex="-1">問題</h2><a id="large" target="_blank" rel="noopener noreferrer"><img id="question" alt="問題文と選択肢" width="1210" /></a><p id="load-error" hidden role="alert">画像の読み込みに失敗しました。</p><p id="save-error" hidden role="alert">復習履歴を保存できませんでした。ブラウザの保存設定を確認してください。</p><fieldset id="choices"><legend>解答を選択</legend><label><input type="radio" name="choice" value="ア"> ア</label><label><input type="radio" name="choice" value="イ"> イ</label><label><input type="radio" name="choice" value="ウ"> ウ</label><label><input type="radio" name="choice" value="エ"> エ</label></fieldset><button id="check" type="button">この問題を採点</button><p id="feedback" role="status" aria-live="polite"></p><section id="explanation" hidden><h3>解説</h3><p id="explanation-text"></p><p><a id="related-chapter" target="_blank" rel="noopener noreferrer" hidden>関連するコンプリートテキストを読む ↗</a></p><p><a id="external-explanation" target="_blank" rel="noopener noreferrer" hidden>外部サイトの詳しい解説を読む ↗</a></p><p><a id="official" target="_blank" rel="noopener noreferrer">IPA公式問題・解答例</a></p></section><button id="next" type="button" hidden>次の問題 →</button></div></section>
</SiteLayout>
<script>
import { am2Years } from '../../data/am2';
import { findAm2Explanation, externalAm2ExplanationUrl } from '../../data/am2-explanations';
import { findAm2QuestionIndex } from '../../data/am2-question-index';
import { recordMistake, listMistakes, syncExistingMistakes } from '../../lib/am2-review';
import type { Am2Choice } from '../../lib/am2-session';

type RandomState = { order: number[]; index: number; results: Record<number, Am2Choice>; runId: string };
const $ = <T extends HTMLElement = HTMLElement>(id: string): T => document.getElementById(id) as T;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const all = am2Years.flatMap(y => Array.from({length: 25}, (_, i) => ({
  id: y.id, label: y.label, list: y.list, number: i + 1, correct: y.key[i]
})));
const storeKey = 'sa-am2-random-v1';
const fastKey = 'sa-am2-random-fast-v1';
const advanceDelayMs = 800;
const choices = ['ア', 'イ', 'ウ', 'エ'];
const state: RandomState = {order: [], index: 0, results: {}, runId: ''};
let fastMode = false;
let advanceTimer: ReturnType<typeof setTimeout> | null = null;
try { fastMode = localStorage.getItem(fastKey) === 'true'; } catch {}
$<HTMLInputElement>('fast-mode').checked = fastMode;

function cancelAdvance(): void {
  if (advanceTimer !== null) { clearTimeout(advanceTimer); advanceTimer = null; }
}
function scheduleAdvance(index: number): void {
  cancelAdvance();
  advanceTimer = setTimeout(() => {
    advanceTimer = null;
    if (fastMode && state.index === index && state.results[state.order[index]]) goNext();
  }, advanceDelayMs);
}
function randomOrder(): number[] {
  const a = Array.from({length: 225}, (_, i) => i);
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
function persist(): void {
  try { localStorage.setItem(storeKey, JSON.stringify(state)); } catch {}
}
function initialize(reset = false): void {
  cancelAdvance();
  let saved: Partial<RandomState> | null = null;
  if (!reset) {
    try { saved = JSON.parse(localStorage.getItem(storeKey) || 'null'); } catch {}
  }
  if (
    saved && Array.isArray(saved.order) && saved.order.length === 225 &&
    new Set(saved.order).size === 225 &&
    saved.order.every(n => Number.isInteger(n) && n >= 0 && n < 225) &&
    Number.isInteger(saved.index) && saved.index! >= 0 && saved.index! <= 225 &&
    saved.results && typeof saved.results === 'object'
  ) {
    state.order = saved.order;
    state.index = saved.index!;
    state.results = saved.results;
    state.runId = typeof saved.runId === 'string' && saved.runId
      ? saved.runId : 'legacy-' + saved.order.slice(0, 12).join('-');
  } else {
    state.order = randomOrder();
    state.index = 0;
    state.results = {};
    state.runId = crypto.randomUUID();
  }
  persist();
  syncExistingMistakes();
  render();
}
function goNext(): void {
  cancelAdvance();
  if (state.index >= 225 || !state.results[state.order[state.index]]) return;
  state.index++;
  persist();
  render();
  $('heading').focus({preventScroll: true});
  window.scrollTo({top: Math.max(0, $('question-card').getBoundingClientRect().top + window.scrollY - 16), behavior: 'auto'});
}
function grade(choice: string): void {
  if (state.index >= 225 || !choices.includes(choice)) return;
  const n = state.order[state.index];
  if (state.results[n]) return;
  const q = all[n];
  state.results[n] = choice as Am2Choice;
  persist();
  if (choice !== q.correct) {
    const saved = recordMistake(q.id, q.number, choice as Am2Choice, 'random:' + state.runId + ':' + n);
    $('save-error').hidden = saved;
  } else {
    $('save-error').hidden = true;
  }
  render();
}
function render(): void {
  const answered = Object.keys(state.results).length;
  const correct = Object.entries(state.results).filter(([i, v]) => all[Number(i)]?.correct === v).length;
  $('stats').textContent = '正解 ' + correct + ' / 解答 ' + answered;
  $('progress').textContent = Math.min(state.index + 1, 225) + ' / 225';
  $('mistake-count').textContent = String(listMistakes().filter(m => m.reviewedAt === null).length);
  $('fast-hint').hidden = !fastMode;
  $('question-card').classList.remove('is-correct', 'is-incorrect');
  if (state.index === 225) {
    cancelAdvance();
    $('heading').textContent = '全225問を完了しました';
    $<HTMLImageElement>('question').hidden = true;
    $('choices').hidden = true; $('check').hidden = true; $('next').hidden = true;
    $('explanation').hidden = true;
    $('feedback').textContent = '正解 ' + correct + ' / 225 問';
    return;
  }
  const q = all[state.order[state.index]];
  const result = state.results[state.order[state.index]];
  $('heading').textContent = q.label + ' · 問' + q.number;
  const url = base + 'practice/questions/' + q.id + '/q' + String(q.number).padStart(2, '0') + '.webp';
  const img = $<HTMLImageElement>('question');
  img.hidden = false;
  if (img.getAttribute('src') !== url) { img.src = url; $('load-error').hidden = true; }
  img.alt = q.label + ' 問' + q.number + 'の問題文と選択肢';
  $<HTMLAnchorElement>('large').href = url;
  $('choices').hidden = false;
  for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="choice"]')) {
    radio.checked = radio.value === result;
    radio.disabled = Boolean(result);
  }
  $('check').hidden = fastMode || Boolean(result);
  $('next').hidden = fastMode || !result;
  $('question-card').classList.toggle('is-correct', Boolean(result && result === q.correct));
  $('question-card').classList.toggle('is-incorrect', Boolean(result && result !== q.correct));
  $('next').textContent = state.index === 224 ? '結果を見る' : '次の問題 →';
  $('feedback').textContent = result
    ? (result === q.correct ? '正解' : '不正解') + ' · あなたの解答：' + result + ' ／ 正解：' + q.correct
    : '';
  $('explanation').hidden = fastMode || !result;
  const explanation = findAm2Explanation(q.id, q.number);
  const indexEntry = findAm2QuestionIndex(q.id, q.number);
  $('explanation-text').textContent = explanation?.text ??
    (indexEntry ? 'テーマ：' + indexEntry.title + '。理解のポイント：' + indexEntry.tip + '\n\n詳しい正答根拠と各選択肢の説明は、以下の外部解説を参照してください。'
      : 'この問題の独自解説はまだ収録されていません。外部解説を参照してください。');
  const related = $<HTMLAnchorElement>('related-chapter');
  related.hidden = !indexEntry;
  if (indexEntry) {
    related.href = base + 'complete/#ch-' + String(indexEntry.chapter).padStart(2, '0');
    related.textContent = '関連教材：第' + indexEntry.chapter + '章を読む ↗';
  }
  const external = externalAm2ExplanationUrl(q.id);
  const link = $<HTMLAnchorElement>('external-explanation');
  link.hidden = !external;
  if (external) {
    link.href = external;
    link.textContent = '外部解説（' + q.label + '・問' + q.number + '）を読む ↗';
  }
  $<HTMLAnchorElement>('official').href = 'https://www.ipa.go.jp/shiken/mondai-kaiotu/' + q.list + '.html';
  if (fastMode && result) scheduleAdvance(state.index);
  else cancelAdvance();
}
$('check').addEventListener('click', () => {
  const choice = document.querySelector<HTMLInputElement>('input[name="choice"]:checked');
  if (!choice) { $('feedback').textContent = '解答を選択してください。'; return; }
  grade(choice.value);
});
$('choices').addEventListener('change', event => {
  const target = event.target as HTMLInputElement;
  if (fastMode && target.name === 'choice') grade(target.value);
});
$<HTMLInputElement>('fast-mode').addEventListener('change', event => {
  fastMode = (event.target as HTMLInputElement).checked;
  try { localStorage.setItem(fastKey, String(fastMode)); } catch {}
  if (fastMode && state.index < 225 && !state.results[state.order[state.index]]) {
    const selected = document.querySelector<HTMLInputElement>('input[name="choice"]:checked');
    if (selected) { grade(selected.value); return; }
  }
  render();
});
$('next').addEventListener('click', goNext);
$('restart').addEventListener('click', () => {
  if (confirm('ランダム演習の進捗を消去して最初からやり直しますか？')) initialize(true);
});
$('question').addEventListener('error', () => { $('load-error').hidden = false; });
window.addEventListener('pagehide', cancelAdvance);
initialize();
</script>
<style>
.random{max-width:900px;margin:0 auto;padding:55px 0}.random h1{font-size:clamp(27px,4vw,40px)}.toolbar{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin:22px 0}.toolbar span{font-weight:700}.toolbar button{margin-left:auto}.question{background:#fff;border:1px solid var(--line);border-radius:10px;padding:24px}.question h2{font-size:21px}.question img{width:100%;height:auto;display:block}.question>a{display:block;overflow-x:auto}fieldset{border:0;padding:20px 0;display:grid;grid-template-columns:repeat(4,1fr);gap:10px}legend{font-weight:700}fieldset label{display:flex;gap:8px;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:8px;padding:12px;font-size:20px;cursor:pointer}button{font:inherit;background:var(--accent);color:white;border:0;border-radius:7px;padding:10px 18px;cursor:pointer}#feedback{font-weight:700}#explanation{padding:15px 20px;background:#f5f7f5;border-radius:8px;margin:16px 0}@media(max-width:650px){.random{padding:30px 0}.question{padding:12px}.question>a img{min-width:690px}.toolbar button{margin-left:0}}
.toolbar-actions{display:flex;align-items:center;gap:12px;margin-left:auto;flex-wrap:wrap}
.toolbar-actions button{margin-left:0}
.fast-toggle{display:inline-flex;align-items:center;gap:9px;font-weight:700;cursor:pointer;white-space:nowrap}
.fast-toggle input{position:absolute;width:1px;height:1px;opacity:0}
.toggle-track{position:relative;width:42px;height:24px;flex:none;border-radius:99px;background:#b3c3bf;transition:background .15s}
.toggle-track::after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;background:white;border-radius:50%;box-shadow:0 1px 3px #0002;transition:transform .15s}
.fast-toggle input:checked+.toggle-track{background:var(--accent)}
.fast-toggle input:checked+.toggle-track::after{transform:translateX(18px)}
.fast-toggle input:focus-visible+.toggle-track{outline:3px solid #d18a36;outline-offset:3px}
.fast-hint{font-size:13px;color:var(--muted);margin:-8px 0 16px}
.question{transition:background-color .12s,border-color .12s}
.question.is-correct{background:#edf8f0;border-color:#9bcfad}
.question.is-incorrect{background:#fff0ef;border-color:#e6b0ac}
@media(max-width:650px){.toolbar-actions{margin-left:0}.fast-hint{margin:0 0 14px}}
@media(prefers-reduced-motion:reduce){.question,.toggle-track,.toggle-track::after{transition:none}}
.review-link{font-size:13px;font-weight:750;color:var(--accent);text-decoration:none;white-space:nowrap}
.review-link:hover{text-decoration:underline}
#explanation-text{white-space:pre-line;line-height:1.8}
#save-error{color:#a53b30;font-size:13px}
</style>